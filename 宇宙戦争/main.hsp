*start
	redraw 0
	color:boxf
	pos 70,30:picload "tit.bmp",1
	color $FF,$00,$00:font "HGñæí©E",100:pos (600-50*11)/2,100:mes ""
    color $FF,$FF,$00:font "HGñæí©E",30:pos 130,180:mes ""
    color $FF,$FF,$FF:font "HGñæí©E",16:pos 190,250:mes "[SPC]ÉLÅ[Ç≈äJén"
    color $FF,$FF,$FF:font "HGñæí©E",16:pos 190,282:mes "[ESC]ÉLÅ[Ç≈èIóπ"
	redraw 1
    repeat
        stick key
        if(key & $10):break
        if(key & $80):end
        await 20
    loop

//-----------------------------
