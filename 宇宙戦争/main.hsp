*br
	if dem==0{
		inv=0
	}else{
		inv=1
		if dem<30{
			pos x,y+30
			gmode 2
			celput 2,9
			dem+=1
		}
		if dem<40 and dem>29{
			pos x,y+30
			gmode 2
			celput 2,10
			dem+=1
		}
		if dem>39{
			pos x,y+30
			gmode 2
			celput 2,11
			dem=0
			ppppp=(x/30)
			if (x\30)>15:ppppp+=1
			cityb(ppppp)=1
			city(ppppp)=2
		}
	}
	
return
