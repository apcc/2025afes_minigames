*enemybirth
	enemyc=0
	foreach fenemyF
	if fenemyF(cnt)==1{
		enemyc+=1
	}
	loop
	if enemyc==0{
		enemypa=rnd(10)
		if enemypa==1{
			q=0
			repeat 6 
			q+=1
			foreach fenemyF
				if fenemyF(cnt)==0{
					fenemyF(cnt)=1 
					fenemyX(cnt)=0-q*40
					fenemyY(cnt)=320
					fenemyA(cnt)=1
					fenemyP(cnt)=1
					fenemyQ(cnt)=6
					fenemyZ(cnt)=0
					fenemyD(cnt)=0
					break
				}
			loop
			loop
		}
		if enemypa==2{
			q=0
			repeat 6 
			q+=1
			foreach fenemyF
				if fenemyF(cnt)==0{
					fenemyF(cnt)=1 
					fenemyX(cnt)=480+q*40
					fenemyY(cnt)=420
					fenemyA(cnt)=2
					fenemyP(cnt)=2
					fenemyQ(cnt)=6
					fenemyZ(cnt)=0
					fenemyD(cnt)=0
					break
				}
			loop
			loop
		}
		if enemypa==3{
			
		}
		if enemypa==4{
			q=0
			repeat 6 
			q+=1
			foreach fenemyF
				if fenemyF(cnt)==0{
					fenemyF(cnt)=1 
					fenemyX(cnt)=120
					fenemyY(cnt)=0-q*40
					fenemyA(cnt)=7
					fenemyP(cnt)=4
					fenemyQ(cnt)=0
					fenemyZ(cnt)=0
					fenemyD(cnt)=0
					break
				}
			loop
			loop
		}
		if enemypa==5{
			q=0
			repeat 6 
			q+=1
			foreach fenemyF
				if fenemyF(cnt)==0{
					fenemyF(cnt)=1 
					fenemyX(cnt)=360
					fenemyY(cnt)=0-q*40
					fenemyA(cnt)=7
					fenemyP(cnt)=5
					fenemyQ(cnt)=0
					fenemyZ(cnt)=0
					fenemyD(cnt)=0
					break
				}
			loop
			loop
		}
		if enemypa==6{
			q=0
			repeat 6 
			q+=1
			foreach fenemyF
				if fenemyF(cnt)==0{
					fenemyF(cnt)=1 
					fenemyY(cnt)=480
					fenemyX(cnt)=0-q*40
					fenemyA(cnt)=1
					fenemyP(cnt)=6
					fenemyQ(cnt)=0
					fenemyZ(cnt)=0
					fenemyD(cnt)=0
					break
				}
			loop
			loop
		}
		if enemypa==7{
			q=0
			repeat 6
			q+=1
			foreach fenemyF
				if fenemyF(cnt)==0{
					fenemyF(cnt)=1
					fenemyY(cnt)=480
					fenemyX(cnt)=480+q*40
					fenemyA(cnt)=2
					fenemyP(cnt)=7
					fenemyZ(cnt)=0
					fenemyD(cnt)=0
					break
				}
			loop
			loop
		}
	}
		
return
