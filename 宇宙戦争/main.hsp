#deffunc towerB int p1,int p2
if p1==5{
	repeat 5
	pos cnt*30+150,p2
	celput 1,16
	loop
	pos 210,p2
	celput 1,17
}
if p1==3{
	repeat 3
	pos cnt*30+180,p2
	celput 1,16
	loop
	pos 210,p2
	celput 1,17
}
if p1==1{
	pos 180,p2
	celput 1,24
	pos 210,p2
	celput 1,17
	pos 240,p2
	celput 1,25
}
if p1==6{
	repeat 5
	pos cnt*30+150,p2
	celput 1,34
	loop
}
if p1==7{
	repeat 3
	pos cnt*30+180,p2
	celput 1,34
	loop
}
if p1==8{
	pos 210,p2
	celput 1,34
}

return
