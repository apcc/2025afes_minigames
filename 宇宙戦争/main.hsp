*myfight
	if (inv==1){
		gmode 2
		repeat 3
		pos x-30+cnt*30,y-30
		celput 2,12+cnt
		loop
		repeat 2
		pos x-30+cnt*60,y
		celput 2,15
		loop
		repeat 2
		pos x-30+cnt*60,y+30
		celput 2,16+cnt
		loop
		pos x,y+30
		celput 2,13
	}
		if (blast==0){
			cool+=1
			demc+=1
			if key&1:x-=spead:if (x<0):x=0
			if key&4:x+=spead:if (x>450):x=450
			if key&2048:gosub *tamabirth
			if key&4096{
				if demc>200{
					dem=1:demc=0
				}
			}
			pos x,y:celput 2,1
		}
		if (blast==1){
Å@Å@Å@		gosub *backscreen
		Å@  gosub *towerp
			pos x,y:celput 2,32
			wait 30
			redraw 1
			gosub *backscreen
		Å@  gosub *towerp
			pos x,y:celput 2,33
			redraw 1
			wait 30
			gosub *backscreen
		Å@  gosub *towerp
			pos x,y:celput 2,34
			redraw 1
			wait 30
			fight-=1
			blast=0
			gosub *backscreen
		Å@  gosub *towerp
			redraw 1
			wait 30
			repeat 40
			kenemyF(cnt)=0
			benemyF(cnt)=0
			fenemyF(cnt)=0
			loop
			repeat 100
			eftamaF(cnt)=0
			ebtamaF(cnt)=0
			loop
			foreach ftamaF
			ftamaF(cnt)=0
			loop
			foreach ttamaF
			ttamaF(cnt)=0
			loop
			x=0
		repeat 70
		  redraw 0
		  gosub *backscreen
		  gosub *towerp
		  gmode 2
		repeat 3
		pos x-30+cnt*30,y-30
		celput 2,12+cnt
		loop
		repeat 2
		pos x-30+cnt*60,y
		celput 2,15
		loop
		repeat 2
		pos x-30+cnt*60,y+30
		celput 2,16+cnt
		loop
		pos x,y+30
		celput 2,13
		pos x,y:celput 2,1
		  x+=3
		  inv=1
		  redraw 1
	      await (1000/60)
		loop
		inv=0
		}
		if (fight==0):goto *gameover
return
