*backscreen
	color:boxf
		repeat 16
		pos cnt*30,690
		celput 1,1
		pos cnt*30,660
		celput 1,city(cnt)
		if cityb(cnt)>0 and cityb(cnt)<10:pos cnt*30,660:celput 1,11:cityb(cnt)+=1
		if cityb(cnt)==9:pos cnt*30,660:celput 1,12:cityb(cnt)=0
		pos cnt*30,600
		celput 1,13
		pos cnt*30,570
		celput 1,14
		pos cnt*30,540
		celput 1,15
		pos cnt*30,510 
		celput 1,2
		loop
		pos 300,100
		gcopy 4,0,0,500,500
return
