*enemym
	foreach fenemyF
		if fenemyF(cnt)==1 and fenemyZ(cnt)==0 {
			if fenemyA(cnt)==0{
			}
			if fenemyA(cnt)==1{
				fenemyX(cnt)+=3
				fenemyQ(cnt)=6
				if fenemyP(cnt)==1 and fenemyX(cnt)>150 and fenemyD(cnt)==0{
					fenemyD(cnt)=1
					tamaB fenemyX(cnt),fenemyY(cnt)
				}
				if fenemyP(cnt)==1 and fenemyX(cnt)>330 and fenemyD(Cnt)==1{
					fenemyD(Cnt)=2
					tamaB fenemyX(cnt),fenemyY(Cnt)
				}
				if fenemyP(cnt)==6 and fenemyX(cnt)>0 and fenemyD(cnt)==0{
					fenemyD(cnt)=1
					fenemyA(cnt)=3
				}
			}
			if fenemyA(cnt)==2{
				fenemyX(cnt)-=3 
				fenemyQ(cnt)=2
				if fenemyP(cnt)==2 and fenemyX(cnt)<240 and fenemyD(cnt)==0{
					fenemyD(cnt)=1
					tamaB fenemyX(cnt),fenemyY(cnt)
				}
				if fenemyP(cnt)==7 and fenemyX(cnt)<480 and fenemyD(cnt)==0:fenemyA(cnt)=4
			}
			if fenemyA(cnt)==3{
				fenemyX(cnt)+=3
				fenemyY(cnt)-=3
				fenemyQ(cnt)=5
				if fenemyP(cnt)==6 and fenemyX(cnt)>150 and fenemyD(cnt)==1{
					fenemyD(cnt)=2
					tamaB fenemyX(cnt),fenemyY(cnt)
					fenemyA(cnt)=5
				}
			}
			if fenemyA(cnt)==4{
				fenemyX(cnt)-=3
				fenemyY(cnt)-=3
				fenemyQ(cnt)=3
				if fenemyP(cnt)==7 and fenemyX(cnt)<100 and fenemyD(cnt)==0{
					fenemyD(cnt)=1
					tamaB fenemyX(cnt),fenemyY(cnt)
					fenemyA(cnt)=6
				}
			}
			if fenemyA(cnt)==5{
				fenemyX(cnt)+=3
				fenemyY(cnt)+=3
				fenemyQ(cnt)=7
				if fenemyP(cnt)==6 and fenemyX(cnt)>300 and fenemyD(cnt)==2{
					fenemyD(cnt)=3
					tamaB fenemyX(cnt),fenemyY(cnt)
					fenemyA(cnt)=1
				}
			}
			if fenemyA(cnt)==6{
				fenemyX(cnt)-=3
				fenemyY(cnt)+=3
				fenemyQ(cnt)=1
			}
			if fenemyA(cnt)==7{
				fenemyY(cnt)+=3
				fenemyQ(cnt)=0
				if fenemyP(cnt)==4 and fenemyY(cnt)>360 and fenemyD(cnt)==1{
					fenemyD(cnt)=2
					tamaB fenemyX(cnt),fenemyY(cnt)
					fenemyA(cnt)=6
				}
				if fenemyP(cnt)==4 and fenemyY(cnt)>100 and fenemyD(cnt)==0{
					fenemyD(cnt)=1
					tamaB fenemyX(cnt),fenemyY(cnt)
				}
				if fenemyP(cnt)==5 and fenemyY(cnt)>100 and fenemyD(cnt)==0{
					fenemyD(cnt)=1
					tamaB fenemyX(cnt),fenemyY(cnt)
				}
				if fenemyP(cnt)==5 and fenemyY(cnt)>360 and fenemyD(cnt)==1{
					fenemyD(cnt)=2
					tamaB fenemyX(cnt),fenemyY(cnt)
					fenemyA(cnt)=5
				}
					
			}
			if fenemyA(cnt)==8{
				fenemyY(cnt)-=3 
				fenemyQ(cnt)=4
			}	
		if fenemyX(cnt)<-330 or fenemyX(cnt)>780 or fenemyY(cnt)<-330 or fenemyY(cnt)>1020: fenemyF(cnt)=0
		}
	loop
	q=-1
	foreach benemyF
	q+=1
		if benemyF(cnt)==1{
			if benemyZ(cnt)==0{
				if rnd(400)==5 {
					foreach ebtamaF
						if ebtamaF(cnt)==0{
							ebtamaF(cnt)=1
							ebtamaX(cnt)=benemyX(q)
							ebtamaY(cnt)=benemyY(q)
							ebtamaH(cnt)=20
							ebtamaYacc(cnt)=1
							ebtamaXacc(cnt)=0
							ebtamaA(cnt)=0
							break
						}
					loop
				}
				if benemyB(cnt)==0{
					benemyX(cnt)+=2
				}
				if benemyB(cnt)==1{
					benemyX(cnt)-=2
				}
			}
		if benemyX(cnt)<-500 or benemyX(cnt)>980 or benemyY(cnt)<-530 or benemyY(cnt)>1220: benemyF(cnt)=0
		}
	loop
return
