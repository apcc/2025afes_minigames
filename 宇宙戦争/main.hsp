*op
	repeat 70
	  redraw 0
	  gosub *backscreen
	  gosub *towerp
	  gosub *myfight
	  x+=3
	  inv=1
	  redraw 1
      await (1000/60)
	loop
	inv=0
//------------------------------
//ÉÅÉCÉìÉãÅ[Év
