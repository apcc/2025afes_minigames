//íeÇÃï\é¶
//-----------------------
*tamap
	foreach ftamaF
		if ftamaF(cnt)==0:continue
		if ftamaF(cnt)==1{
			if ftamaB(cnt)==0{	
				ftamaX(cnt)+=ftamaXacc(cnt)
				ftamaY(cnt)+=ftamaYacc(cnt)
				if ftamaX(cnt)<0 or ftamaX(cnt)>480:ftamaF(cnt)=0
				if ftamaY(cnt)<0 or ftamaY(cnt)>720:ftamaF(cnt)=0
				pos ftamaX(cnt),ftamaY(cnt)
				if ftamaL(cnt)==0: gmode 2:gcopy 2,60,0,10,10
				if ftamaL(cnt)==1: gmode 2:gcopy 2,90,0,30,30
				if ftamaL(cnt)==2: gmode 2:gcopy 2,120,0,60,30
				if ftamaL(cnt)==3: gmode 2:gcopy 2,210,0,90,30
			}
			if ftamaB(cnt)==1{
				gmode 2
				pos ftamaX(cnt),ftamaY(cnt)
				celput 2,33
				ftamaB(cnt)=2
			}
			if ftamaB(cnt)==2{
				gmode 2
				pos ftamaX(cnt),ftamaY(cnt)
				celput 2,34
				ftamaB(cnt)=3
			}
			if ftamaB(cnt)==3{
				gmode 2
				pos ftamaX(cnt),ftamaY(cnt)
				celput 2,35
				ftamaF(cnt)=0
			}

				
		}
			
	loop
		foreach ttamaF
		if ttamaF(cnt)==0:continue
		if ttamaF(cnt)==1{
			if ttamaB(cnt)==0{
				ttamaX(cnt)+=ttamaXacc(cnt)
				ttamaY(cnt)+=ttamaYacc(cnt)
				if ttamaX(cnt)<0 or ttamaX(cnt)>480:ttamaF(cnt)=0
				if ttamaY(cnt)<0 or ttamaY(cnt)>720:ttamaF(cnt)=0
				pos ttamaX(cnt),ttamaY(cnt)
				gmode 2:gcopy 2,60,10,10,10
			}
				if ttamaB(cnt)==1{
					gmode 2
					pos ttamaX(cnt),ttamaY(cnt)
					celput 2,34
					ttamaB(cnt)=2
				}
				}
				if ttamaB(cnt)==2{
					gmode 2
					pos ftamaX(cnt),ftamaY(cnt)
					celput 2,35
					ftamaF(cnt)=0
				}
		
			
	loop
return
