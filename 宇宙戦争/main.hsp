//ìÉÇÃï`âÊ
//-------------------------
*towerp
	ds=3
	repeat
		if tower>50*cnt{
			ds+=1
		}else{
			break
		}
	loop
	repeat 17
		if tower>10*cnt{
			if cnt<5:towerB 5,510-cnt*30
			if cnt>4 and cnt<11:towerB 3,510-cnt*30
			if cnt>10 and cnt<16:towerB 1,510-cnt*30
		}else{
			if cnt<5:towerB 6,510-cnt*30
			if cnt>4 and cnt<11:towerB 7,510-cnt*30
			if cnt>10 and cnt<16:towerB 8,510-cnt*30
			break
		}
	loop
return
//-------------------
//â_ÇÃï`âÊ
//-------------------
*cloud
	foreach skyF
		if skyF(cnt)==0:continue
		if skyF(cnt)==1{
			if skyB(cnt)==0{
				skyX(cnt)+=1
				if skyX(cnt)>480:skyF(cnt)=0
				pos skyX(cnt),skyY(cnt)
				gmode 2
				gcopy 6,0,0,200,200
			}
			if skyB(cnt)==1{
				skyX(cnt)-=1
				if skyX(cnt)<-130:skyF(cnt)=0
				pos skyX(cnt),skyY(cnt)
				gmode 2
				gcopy 5,0,0,200,200
			}
		}
	loop	
return
//-----------------
//â_ÇÃê∂ê¨
//-----------------
*cloudbirth
	if rnd(300)=1{
		foreach skyF
			if skyF(cnt)==0{
				skyF(cnt)=1
				ppp=rnd(2)
				skyB(cnt)=ppp
				skyY(cnt)=rnd(400)+150
				if ppp=0:skyX(cnt)=-200
				if ppp=1:skyX(cnt)=500
				break
			}
		loop
	}
return
//----------------
//ñØä‘êlï\é¶
//----------------
*citp
	foreach citizenF
		if citizenF(cnt)==0:continue
		if citizenF(cnt)==1{
			pos citizenX(cnt),citizenY(cnt)
			gmode 2
			celput 2,36
			citizenA(cnt)+=1
			if citizenY(cnt)>650{
				if citizenY(cnt)>690{
					if citizenX(cnt)<240{
						citizenX(cnt)-=1
						if citizenX(cnt)<-30{
							citizenY(cnt)=510
						}
					}else{
						citizenX(cnt)+=1
						if citizenX(cnt)>480{
							citizenY(cnt)=510
						}
					}
				}else{
					citizenY(cnt)+=1
				}
			}else{
				if citizenX(cnt)>209 and citizenX(cnt)<241{
					citizenF(cnt)=0
					tower+=1
				}
				if citizenX(cnt)<210{
					citizenX(cnt)+=1
			}else{
				if citizenX(cnt)>240{
					citizenX(cnt)-=1
				}
			}
		}
		}
	loop
return
//---------------
//í¨ÇÃèàóù
//---------------
*citygrow
	spead=1
	mgan=0
	sgan=0
	sgans=128
	ppppp=0
	if tower>510:goto *hend
	foreach city
	if city(cnt)==2{
		r=rnd(1600)
		if r==1 or r==3 :city(cnt)=4
		if r==2:city(cnt)=3
	}
	if city(cnt)==4{
		r=rnd(1000)
		if r==1:city(cnt)=5
	}
	if city(cnt)==5{
		r=rnd(7000)
		if r==1:city(cnt)=6
		if r==2:city(cnt)=7
		if r==3:city(cnt)=8
		if r==4:city(cnt)=9
		if r==5:city(cnt)=10
		if r==6:city(cnt)=4
	}
	if city(cnt)==6{
		r=rnd(200)
		if r==1{
			foreach citizenF
			if citizenF(cnt)==0{
				citizenF(cnt)=1
				citizenY(cnt)=660
				citizenA(cnt)=0
				citizenX(cnt)=ppppp*30
				break
			}
			loop	
		}
	}
	if city(cnt)=7:mgan+=1
	if city(cnt)=8:sgans=sgans/2
	if city(cnt)=9:spead+=1
	if city(cnt)=10:sgan+=1
	ppppp+=1
	loop
return
//-------------------
//íeî≠éÀ
//-------------------
#deffunc tamaB int p1,int p2
	foreach eftamaF
		if eftamaF(cnt)==0{
			 eftamaF(cnt)=1
			 eftamaX(cnt)=p1
			 eftamaY(cnt)=p2
			kkd=atan(y-p2, x-p1) ;ìGÇ∆é©ã@Ç∆ÇÃäpìxÇãÅÇﬂÇÈ
			eftamaXacc(cnt)= cos(kkd)*ds
			eftamaYacc(cnt)=sin(kkd)*ds
			break
		} 
	loop
	foreach eftamaF
		if eftamaF(cnt)==0{
			 eftamaF(cnt)=1
			 eftamaX(cnt)=p1
			 eftamaY(cnt)=p2
			kkd=atan(y-p2, x-p1) ;ìGÇ∆é©ã@Ç∆ÇÃäpìxÇãÅÇﬂÇÈ
			eftamaXacc(cnt)= cos(kkd)*ds+1
			eftamaYacc(cnt)=sin(kkd)*ds
			break
		} 
	loop
	foreach eftamaF
		if eftamaF(cnt)==0{
			 eftamaF(cnt)=1
			 eftamaX(cnt)=p1
			 eftamaY(cnt)=p2
			kkd=atan(y-p2, x-p1) ;ìGÇ∆é©ã@Ç∆ÇÃäpìxÇãÅÇﬂÇÈ
			eftamaXacc(cnt)= cos(kkd)*ds-1
			eftamaYacc(cnt)=sin(kkd)*ds
			break
		} 
	loop
return
