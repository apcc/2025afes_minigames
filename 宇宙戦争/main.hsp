*knenemyb
	if tower <10{
		enemyc=0
		foreach kenemyF
			if kenemyF(cnt)==1{
			enemyc+=1
			}
		loop
		if enemyc==0{
			repeat 2
				foreach kenemyF
					if kenemyF(cnt)==0{
					kenemyF(cnt)=1
					kenemyX(cnt)=rnd(450)
					kenemyY(cnt)=-30
					kenemyYacc(cnt)=200+rnd(200)
					kenemyZ(cnt)=0
					break
					}
				loop
					
			loop
		}
			
		
	
	}
//----------------------
//ìGã@ÇÃíeï\é¶
//-----------------------
*enemytamap
	foreach eftamaF
		if eftamaF(cnt)==1{
			pos eftamaX(cnt),eftamaY(cnt)
			gmode 2
			gcopy 2,210,60,10,10
			eftamaX(cnt)+=eftamaXacc(cnt)
			eftamaY(cnt)+=eftamaYacc(cnt)
			if eftamaX(cnt)<-530 or eftamaX(cnt)>980 or eftamaY(cnt)<-530 or eftamaY(cnt)>1220: eftamaF(cnt)=0
		}
	loop
	foreach ebtamaF
		if ebtamaF(cnt)==1{
			pos ebtamaX(cnt),ebtamaY(cnt)
			gmode 2
			gcopy 2,180,60,30,30
			ebtamaX(cnt)+=ebtamaXacc(cnt)
			ebtamaY(cnt)+=ebtamaYacc(cnt)
			if ebtamaX(cnt)<0 or ebtamaX(cnt)>480 or ebtamaY(cnt)<-530 or ebtamaY(cnt)>1220: ebtamaF(cnt)=0
		}
	loop
//-----------------------
//ìGã@ÇÃï\é¶
//-----------------------
*enemyp 
	foreach fenemyF
		if fenemyF(cnt)==1{
			if fenemyZ==0{
				pos fenemyX(cnt),fenemyY(cnt)
				gmode 2
				celput 2,18,1,1,((M_PI/4)*fenemyQ(cnt))
			}
			if fenemyZ(cnt)==1{
				pos fenemyX(cnt),fenemyY(cnt)
				celput 2,33
				fenemyF(cnt)=0
			}
			if fenemyZ(cnt)==2{
				pos fenemyX(cnt),fenemyY(cnt)
				celput 2,34
				fenemyZ(cnt)=3
			}
			if fenemyZ(cnt)==3{
				pos fenemyX(cnt),fenemyY(cnt)
				celput 2,35
				fenemyF(cnt)=0
			}
		}
	loop
	foreach benemyF
		if benemyF(cnt)==1{
			if benemyZ(cnt)==0{
				pos benemyX(cnt),benemyY(cnt)
				gmode 2
				if benemyB(cnt)==1:gcopy 2,30,60,90,30
				if benemyB(cnt)==0:gcopy 2,30,120,90,30
			}
			if benemyZ(cnt)==1{
				pos benemyX(cnt),benemyY(cnt)
				gmode 2
				gcopy 2,0,90,90,30
				benemyZ(cnt)=2
			}
			if benemyZ(cnt)==2{
				pos benemyX(cnt)+15,benemyY(cnt)
				gmode 2
				gcopy 2,90,90,60,30
				benemyZ(cnt)=3
			}
			if benemyZ(cnt)==3{
				pos benemyX(cnt)+30,benemyY(cnt)
				gmode 2
				gcopy 2,150,90,30,30
				benemyF(cnt)=0
			}
			
		}
		
				
	loop
	foreach kenemyF
		if kenemyF(cnt)==1{
				if kenemyYacc(cnt)<kenemyY(cnt):kenemyZ(cnt)=1
				if kenemyZ(cnt)==0{
					kenemyY(cnt)+=1
					pos kenemyX(cnt),kenemyY(cnt)
					gmode 2
					celput 2,26
				}
				if kenemyZ(cnt)>0 and kenemyZ(cnt)<60{
					pos kenemyX(cnt),KenemyY(cnt)
					gmode 2
					celput 2,26
					kenemyZ(cnt)+=1
				}
				if kenemyZ(cnt)==20:kenemyF(cnt)=0
		}
	loop
return
