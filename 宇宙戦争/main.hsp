*enemyBB
	enemyc=0
	foreach benemyF
	if benemyF(cnt)==1{
		enemyc+=1
	}
	loop
	if enemyc==0 and rnd(100)==1{
		q=0
			repeat 4
			q+=1
			foreach benemyF
				if benemyF(cnt)==0{
					benemyB(cnt)=rnd(2)
					benemyF(cnt)=1
					if benemyB(cnt)==0:benemyX(cnt)=0-120*q
					if benemyB(cnt)==1:benemyX(cnt)=480+120*q					
					benemyY(cnt)=60+rnd(200)
					benemyT(Cnt)=0
					benemyZ(cnt)=0
					break
				}
			loop
			loop
	}
return
